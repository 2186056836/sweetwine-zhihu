// Zhihu OAuth login binding — manually added (NOT generated from mirror.db;
// scripts/gen_prisma_from_mirror.py will drop it, re-append after regeneration).
// zhihu_uid stores the int64 uid as a lossless string (may exceed 2^53).
model zhihuIdentities {
  @@map("zhihu_identities")
  zhihu_uid        String  @id
  hash_id          String?
  user_id          String
  fullname         String?
  avatar_path      String?
  access_token     String?
  token_expires_at Float?
  created_at       String?
  updated_at       String?
}
