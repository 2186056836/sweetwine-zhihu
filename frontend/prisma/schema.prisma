  mediaType String?
  mediaUrl String?
  firstFrameUrl String?
  caption String?
  isPublished Boolean?
  sortOrder Float?
  createdAt String?
  updatedAt String?
}
model groupChats {
  @@map("group_chats")
  id String @id
  userId String?
