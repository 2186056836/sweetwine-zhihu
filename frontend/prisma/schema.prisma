  createdAt String?
}

model roleplaySessions {
  @@map("roleplay_sessions")
  id String @id
  userId String?
  companionId String?
  locationId String?
  tone String?
  sceneOpening String?
  scenarioPrompt String?
  sceneImageUrl String?
  scLastResponseId String?
  scSystemHash String?
  turnCount Float?
  createdAt String?
  updatedAt String?
}

model roleplaySessionMessages {
  @@map("roleplay_session_messages")
  id String @id
  roleplaySessionId String?
  role String?
  content String?
  canonicalContent Int?
  createdAt String?
}

model messages {
  @@map("messages")
  id String @id
  userId String?
  companionId String?
  content String?
  canonicalContent Int?
  role String?
  storyId String?
  storyLiked Boolean?
  createdAt String?
}

model conversationStates {
  @@map("conversation_states")
  id String @id
  userId String?
  companionId String?
  scLastResponseId String?
  scSystemHash String?
  turnCount String?
  roleplayScenario String?
  // Manual additions (mirror dump lacks these — gen_prisma_from_mirror.py drops
  // them; re-add alongside zhihuIdentities after any regeneration).
  // Rolling long-term memory of the 1v1 chat (hermes-style folded summary),
  // the fold cursor (messages already absorbed) and consecutive-fold-failure
  // counter (skip the batch after 3 so a dead summarizer never wedges memory).
  memorySummary String?
  memoryMsgCount Int? @default(0)
  memoryFoldFails Int? @default(0)
  createdAt String?
  updatedAt String?
}

model zhihuMaterials {
  @@map("zhihu_materials")
  id String @id
  topic String?
  questionTitle String?
  questionUrl String?
  answerCount Int? @default(0)
  excerptsJson String?
  companionId String?
  createdAt String?
}

model media {
