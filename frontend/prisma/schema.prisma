generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  @@map("users")
  id String @id
  email String?
  nickname String?
  gender String?
  preferredLanguage Float?
  aiLanguage String?
  ageVerified Boolean?
  dateOfBirth String?
  aiActConsent Boolean?
  aiActConsentAt String?
  newsletter Boolean?
  aiTrainingConsent Boolean?
  billingCardHolder String?
  billingFirstName String?
  billingLastName String?
  billingCity String?
  billingCountry String?
  billingPostcode String?
  billingStreet String?
  finbyCardId String?
  finbyCardMask String?
  finbyCardExpiration String?
  finbyCardAccountId String?
  autoTopUpEnabled Boolean?
  autoTopUpAddonKey String?
  autoTopUpThreshold String?
  autoTopUpLastAt String?
  autoTopUpLastError String?
  autoTopUpFailCount Float?
  dognetVisitorId String?
  referralCode String?
  referredByUserId String?
  createdAt String?
  updatedAt String?
  lastActiveAt String?
  contentPurgedAt String?
  deletedAt String?
  pass_hash String?
  salt String?
  iters Int?
  password_set Boolean?
}

model referrals {
  @@map("referrals")
  id String @id
  referrerId String?
  referredUserId String?
  status String?
  tokensAwarded String?
  createdAt String?
  rewardedAt String?
}

model companions {
  @@map("companions")
  id String @id
  slug String?
  name String?
  age Float?
  archetype String?
  personality String?
  background String?
  body String?
  ethnicity String?
  relationship String?
  occupation String?
  hobbies String?
  language String?
  imageUrl String?
  videoUrl String?
  bio String?
  systemPrompt String?
  conciseSystemPrompt String?
  isCustom Boolean?
  isNew Boolean?
  isPublished Boolean?
  groupChatFeatured Boolean?
  userId String?
  totalTokenSpendings Float?
  createdAt String?
  updatedAt String?
  elevenLabsAgentId String?
  voiceId String?
  voiceSystemPrompt String?
  trulienceAvatarId String?
  nameTranslations String?
  bioTranslations String?
  personalityTranslations String?
  backgroundTranslations String?
  occupationTranslations String?
  hobbiesTranslations String?
  bodyTranslations String?
  ethnicityTranslations String?
  relationshipTranslations String?
  welcomeMessage String?
  welcomeMessageTranslations String?
}

model igStories {
  @@map("ig_stories")
